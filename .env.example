DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_erp?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
# Only needed if the UI is hosted on a different origin than the API
# CORS_ORIGIN="http://localhost:5173"

# UHF reader must send this in header  x-reader-key  (leave empty to disable the check)
READER_API_KEY="change-me-reader-key"

# Attendance rules
TZ_OFFSET_MIN=330
LATE_AFTER="08:30"

# Optional WhatsApp provider (any HTTP API). If empty, messages are only logged.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# ---------- Backup ----------
# Where backup files are saved on the server (default: ./backups)
# BACKUP_DIR="D:/school-erp-backups"
# Full-database .bak uses pg_dump when it is installed (set the path if it is not on PATH), otherwise a portable SQL .bak is written
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/16/bin/pg_dump.exe"

# ---------- Google Drive copy (optional) ----------
# The folder in your Google Drive that receives the backups (open it, copy the last part of its web address)
# GOOGLE_DRIVE_FOLDER_ID=""
# Option A, normal Google account: create an OAuth client in Google Cloud Console, get a refresh token (README explains)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REFRESH_TOKEN=""
# Option B, a Shared Drive: service account key file
# GOOGLE_SERVICE_ACCOUNT_FILE="./google-service-account.json"
